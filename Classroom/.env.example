NODE_ENV=development
PORT=4100
WEB_ORIGIN=http://localhost:4173
PUBLIC_WEB_URL=http://localhost:4173
JWT_SECRET=replace-with-at-least-32-random-characters
TEACHER_ACCESS_CODE=jack-demo

# Tencent TRTC remains disabled until real credentials are configured.
TRTC_ENABLED=false
TRTC_SDK_APP_ID=
TRTC_SECRET_KEY=

# Production persistence. The first local vertical slice falls back to memory.
DATABASE_URL=postgresql://flowrecorder:flowrecorder@localhost:5432/flowrecorder
REDIS_URL=redis://localhost:6379

# Payments are deliberately disabled in 0.1.
PAYMENTS_ENABLED=false
