NODE_ENV=development
PORT=4100
WEB_ORIGIN=http://localhost:4173
# Re-detect the current LAN address whenever a classroom link is requested.
PUBLIC_WEB_URL=auto
# Development uses Vite on 4173. The bundled Mac App leaves this unset and serves everything on 4100.
PUBLIC_WEB_PORT=4173
# Set this to the built web directory when the server should also host the classroom UI.
WEB_DIST_DIR=
JWT_SECRET=replace-with-at-least-32-random-characters
TEACHER_ACCESS_CODE=jack-demo

# Keep this enabled during local development. The server will refuse TRTC and payments.
ZERO_COST_MODE=true

# Tencent TRTC remains disabled until real credentials are configured.
TRTC_ENABLED=false
TRTC_SDK_APP_ID=
TRTC_SECRET_KEY=
# Set true only after enabling the TRTC console's PrivateMapKey permission check.
TRTC_STRICT_PERMISSIONS=false

# Local development uses an atomic state file; production must use PostgreSQL.
PERSISTENCE_DRIVER=file
PERSISTENCE_FILE=.data/classroom-state.json
DATABASE_URL=postgresql://flowrecorder:flowrecorder@localhost:5432/flowrecorder
REDIS_URL=redis://localhost:6379

# Payments are deliberately disabled in 0.1.
PAYMENTS_ENABLED=false
